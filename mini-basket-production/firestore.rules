// DRAFT: DO NOT DEPLOY WITHOUT FIRESTORE EMULATOR TESTS.
// Parent login uses anonymous Firebase Authentication; name selection is NOT proof of identity.
// Admin UID documents must be created with privileged Firebase Admin SDK / Firebase Console.
// Only published months allow parent edits. Actual cutoff uses request.time, not device clock.
rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function isAdmin() {
    return signedIn()
      && request.auth.token.firebase.sign_in_provider == 'google.com'
      && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
  }
  function monthPath(teamId, monthId) {
    return /databases/$(database)/documents/teams/$(teamId)/months/$(monthId);
  }
  function dayPath(teamId, monthId, dateId) {
    return /databases/$(database)/documents/teams/$(teamId)/months/$(monthId)/days/$(dateId);
  }
  function memberPath(teamId, memberId) {
    return /databases/$(database)/documents/teams/$(teamId)/members/$(memberId);
  }
  function openForAnswers(teamId,monthId) {
    return exists(monthPath(teamId,monthId))
      && get(monthPath(teamId,monthId)).data.publication == 'published'
      && get(monthPath(teamId,monthId)).data.inputState == 'open'
      && request.time >= get(monthPath(teamId,monthId)).data.openAt
      && request.time < get(monthPath(teamId,monthId)).data.cutoffAt;
  }
  function eligibleMember(teamId,memberId,dateId) {
    return exists(memberPath(teamId,memberId))
      && get(memberPath(teamId,memberId)).data.status == 'active'
      && get(memberPath(teamId,memberId)).data.startDate <= dateId
      && (get(memberPath(teamId,memberId)).data.endDate == null
        || get(memberPath(teamId,memberId)).data.endDate >= dateId);
  }
  function validAnswerWrite(teamId,monthId,answerId) {
    let d=request.resource.data;
    return signedIn()
      && d.keys().hasOnly(['date','memberId','kind','updatedAt','updatedBy'])
      && d.keys().hasAll(['date','memberId','kind','updatedAt','updatedBy'])
      && d.date is string && d.memberId is string
      && answerId == d.date + '_' + d.memberId
      && d.kind in ['x','o']
      && d.updatedBy == request.auth.uid
      && d.updatedAt == request.time
      && openForAnswers(teamId,monthId)
      && eligibleMember(teamId,d.memberId,d.date)
      && exists(dayPath(teamId,monthId,d.date))
      && get(dayPath(teamId,monthId,d.date)).data.type == 'practice'
      && get(dayPath(teamId,monthId,d.date)).data.ownerId is string
      && ( (d.kind == 'x' && get(dayPath(teamId,monthId,d.date)).data.ownerId == d.memberId)
        || (d.kind == 'o' && get(dayPath(teamId,monthId,d.date)).data.ownerId != d.memberId));
  }
  match /admins/{uid} {
    allow get: if isAdmin() && request.auth.uid == uid;
    allow list,write: if false; // Only Admin SDK may grant administrator status
  }
  match /teams/{teamId} {
    allow read: if signedIn();
    allow write: if isAdmin();
    match /members/{memberId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /months/{monthId} {
      allow read: if signedIn();
      allow write: if isAdmin();
      match /days/{dateId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }
      match /answers/{answerId} {
        allow read: if signedIn();
        allow create,update: if isAdmin() || validAnswerWrite(teamId,monthId,answerId);
        allow delete: if isAdmin() || (
          signedIn()
          && openForAnswers(teamId,monthId)
          && resource.data.memberId is string
          && resource.data.date is string
          && answerId == resource.data.date + '_' + resource.data.memberId
          && eligibleMember(teamId,resource.data.memberId,resource.data.date)
        );
      }
    }
    match /private/{id} { allow read,write: if isAdmin(); }
    match /audit/{id} { allow read: if isAdmin(); allow write: if false; }
    match /alerts/{id} { allow read: if isAdmin(); allow write: if false; }
  }
 }
}
