rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  // This placeholder is deliberately not a real UID. Configure before deployment.
  function isAdmin() {
    return signedIn()
      && request.auth.uid in ['REPLACE_WITH_GOOGLE_ADMIN_UID']
      && request.auth.token.firebase.sign_in_provider == 'google.com';
  }
  function monthRef(t,m) {
    return /databases/$(database)/documents/teams/$(t)/months/$(m);
  }
  function memberRef(t,p) {
    return /databases/$(database)/documents/teams/$(t)/members/$(p);
  }
  function dayRef(t,m,d) {
    return /databases/$(database)/documents/teams/$(t)/months/$(m)/days/$(d);
  }
  function openForParents(t,m) {
    return exists(monthRef(t,m))
      && get(monthRef(t,m)).data.inputState == 'open'
      && get(monthRef(t,m)).data.publication == 'published'
      && request.time >= get(monthRef(t,m)).data.openAt
      && request.time < get(monthRef(t,m)).data.cutoffAt;
  }
  function activeMember(t,p) {
    return exists(memberRef(t,p))
      && get(memberRef(t,p)).data.status == 'active';
  }
  function validMark(t,m,p,d) {
    return exists(dayRef(t,m,d))
      && get(dayRef(t,m,d)).data.type == 'practice'
      && get(dayRef(t,m,d)).data.ownerId is string
      && (
        (request.resource.data.kind == 'x' && get(dayRef(t,m,d)).data.ownerId == p)
        || (request.resource.data.kind == 'o' && get(dayRef(t,m,d)).data.ownerId != p)
      );
  }
  match /teams/{teamId} {
    allow read: if signedIn();
    allow write: if isAdmin();
    match /members/{memberId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /months/{monthId} {
      allow read: if signedIn();
      allow write: if isAdmin();
      match /days/{dateId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }
      match /responses/{memberId}/days/{dateId} {
        allow read: if signedIn();
        allow create, update: if isAdmin() || (
          signedIn()
          && openForParents(teamId,monthId)
          && activeMember(teamId,memberId)
          && request.resource.data.keys().hasOnly(['kind','updatedBy','updatedAt'])
          && request.resource.data.keys().hasAll(['kind','updatedBy','updatedAt'])
          && request.resource.data.kind in ['x','o']
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && validMark(teamId,monthId,memberId,dateId)
        );
        allow delete: if isAdmin() || (
          signedIn() && openForParents(teamId,monthId)
          && activeMember(teamId,memberId)
        );
      }
    }
    match /audit/{eventId} {
      allow read: if isAdmin();
      allow write: if false; // Server-side Admin SDK only
    }
    match /alerts/{alertId} {
      allow read: if isAdmin();
      allow write: if false; // Server-side Admin SDK only
    }
    match /private/{privateId} {
      allow read,write: if isAdmin();
    }
  }
 }
}
